# Application Server Settings
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false

# Music Engine Provider Configuration
# Options: "mock" (default, local synthesizer) or "external_api" (when configured)
MUSIC_PROVIDER=mock

# External Music Generation API Settings (Optional - leave empty for mock mode)
MUSIC_API_URL=
MUSIC_API_KEY=

# Audio Output Settings
OUTPUT_DIR=outputs
DEFAULT_SAMPLE_RATE=48000
TARGET_LUFS=-16
